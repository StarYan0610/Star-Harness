APP_ENV=local
DATABASE_URL=sqlite:///./.coding-agent/coding-agent.db
DEFAULT_EXECUTOR=codex
DEFAULT_PLANNER=openai
DEFAULT_REVIEWER=command
DEFAULT_STRATEGY=skeleton-first
DEFAULT_MAX_TASKS=6
HARD_MAX_TASKS=8
MAX_TASK_ATTEMPTS=2
RETRY_FEEDBACK_MAX_CHARS=10000
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_TIMEOUT_SECONDS=60
PLANNER_TEMPERATURE=0.1
CODEX_COMMAND=codex
CLAUDE_COMMAND=claude
CLAUDE_PERMISSION_MODE=acceptEdits
EXECUTOR_TIMEOUT_SECONDS=3600
VERIFICATION_TIMEOUT_SECONDS=300
REQUIRE_CLEAN_GIT_WORKTREE=false
COMMIT_ON_SUCCESS=false
DEFAULT_OUTPUT_FORMAT=human
LOG_LEVEL=INFO
